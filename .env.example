# Estas variáveis são configuradas no painel da Vercel (Settings > Environment Variables).
# NUNCA coloque os valores reais em arquivos do projeto nem no GitHub.

# Senha do administrador (obrigatória). Use algo longo.
ADMIN_PASSWORD=

# Texto aleatório longo para assinar a sessão de administrador (recomendado).
SESSION_SECRET=

# Criada automaticamente quando você conecta um Blob Store ao projeto.
BLOB_READ_WRITE_TOKEN=

# Opcional: só se quiser o assistente de IA funcionando.
ANTHROPIC_API_KEY=
CHAT_MODEL=
